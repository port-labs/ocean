{
  "description": "Plain integration for Port Ocean",
  "icon": "Plain",
  "title": "Plain",
  "docs": "https://docs.port.io/context-lake/ingestion/ingest-data-into-port/native-integrations/available-integrations/project-management/plain/",
  "formMappingEnabled": true,
  "testConnectionAvailable": true,
  "testConnectionScopes": [],
  "features": [
    {
      "type": "exporter",
      "section": "Project management",
      "resources": [
        {
          "kind": "company"
        },
        {
          "kind": "tenant"
        },
        {
          "kind": "user"
        },
        {
          "kind": "machine-user"
        },
        {
          "kind": "customer"
        },
        {
          "kind": "thread"
        },
        {
          "kind": "thread-message"
        },
        {
          "kind": "discussion"
        },
        {
          "kind": "discussion-message"
        }
      ]
    }
  ],
  "configurations": [
    {
      "name": "apiToken",
      "required": true,
      "type": "string",
      "sensitive": true,
      "description": "Plain API key sent as a Bearer token"
    },
    {
      "name": "apiUrl",
      "required": false,
      "type": "url",
      "default": "https://core-api.uk.plain.com/graphql/v1",
      "description": "Plain GraphQL API endpoint"
    },
    {
      "name": "webhookSecret",
      "required": false,
      "type": "string",
      "sensitive": true,
      "description": "Optional. Not required to register the Plain webhook target. When set (Plain Settings → Request signing), verifies Plain-Request-Signature on inbound events. When unset, signature verification is skipped."
    }
  ]
}
