        },
        "publicName": {
          "type": "string",
          "title": "Public Name"
        },
        "timeZone": {
          "type": "string",
          "title": "Time Zone"
        },
        "isExternalCollaborator": {
          "type": "boolean",
          "title": "External Collaborator"
        },
        "isGuest": {
          "type": "boolean",
          "title": "Guest"
        },
        "url": {
          "type": "string",
          "title": "URL",
          "format": "url"
        }
      },
      "required": []
    },
    "relations": {}
