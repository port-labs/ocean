        },
        "position": {
          "type": "number",
          "title": "Position"
        },
        "content": {
          "type": "string",
          "title": "Content",
          "format": "markdown"
        },
        "folderPath": {
          "type": "string",
          "title": "Folder Path"
        },
        "filePath": {
          "type": "string",
          "title": "File Path"
        },
        "url": {
          "type": "string",
          "title": "URL",
          "format": "url"
        }
      },
      "required": []
    },
    "relations": {
      "space": {
        "title": "Space",
        "target": "confluenceSpace",
        "required": false,
        "many": false
      },
      "parent": {
        "title": "Parent Page",
        "target": "confluencePage",
        "required": false,
        "many": false
      },
      "author": {
        "title": "Author",
        "target": "confluenceUser",
        "required": false,
        "many": false
      },
      "owner": {
        "title": "Owner",
        "target": "confluenceUser",
        "required": false,
        "many": false
      }
    }
  },
  {
