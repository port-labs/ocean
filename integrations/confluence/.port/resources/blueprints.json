[
  {
    "identifier": "confluenceSpace",
    "title": "Confluence Space",
    "icon": "Confluence",
    "schema": {
      "properties": {
        "key": {
          "type": "string",
          "title": "Key"
        },
        "type": {
          "type": "string",
          "title": "Type",
          "enum": [
            "global",
            "collaboration",
            "knowledge_base",
            "personal",
            "system",
            "onboarding",
            "xflow_sample_space"
          ]
        },
        "status": {
          "type": "string",
          "title": "Status",
          "enum": ["current", "archived", "trashed"],
          "enumColors": {
            "current": "green",
            "archived": "yellow",
            "trashed": "red"
          }
        },
        "description": {
          "type": "string",
          "title": "Description",
          "format": "markdown"
        },
        "createdAt": {
          "type": "string",
          "title": "Created At",
          "format": "date-time"
        },
        "homepageId": {
          "type": "string",
          "title": "Homepage ID"
        },
        "authorId": {
          "type": "string",
          "title": "Author Account ID"
        },
        "spaceOwnerId": {
          "type": "string",
          "title": "Owner Account ID"
        },
        "url": {
          "type": "string",
          "title": "URL",
          "format": "url"
        }
      },
      "required": []
    },
    "relations": {
      "author": {
        "title": "Author",
        "target": "confluenceUser",
        "required": false,
        "many": false
      },
      "owner": {
        "title": "Owner",
        "target": "confluenceUser",
        "required": false,
        "many": false
      }
    }
  },
  {
