          "enum": ["current", "draft", "archived", "historical", "trashed", "deleted"],
          "enumColors": {
            "current": "green",
            "draft": "blue",
            "archived": "yellow",
            "historical": "lightGray",
            "trashed": "red",
            "deleted": "red"
          }
        },
        "subtype": {
          "type": "string",
          "title": "Subtype"
        },
        "createdAt": {
          "type": "string",
          "title": "Created At",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "title": "Updated At",
          "format": "date-time"
        },
        "version": {
          "type": "number",
          "title": "Version"
        },
        "parentType": {
          "type": "string",
