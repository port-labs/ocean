        "many": true
      },
      "lead": {
        "title": "Incident lead",
        "target": "incidentIoUser",
        "required": false,
        "many": false
      },
      "creator": {
        "title": "Creator",
        "target": "incidentIoUser",
        "required": false,
        "many": false
      }
    }
