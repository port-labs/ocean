  {
    "identifier": "incidentIoIncident",
    "title": "incident.io Incident",
    "icon": "Alert",
    "schema": {
      "properties": {
        "reference": {
          "type": "string",
          "title": "Reference"
        },
        "summary": {
          "type": "string",
          "title": "Summary"
        },
        "status": {
          "type": "string",
          "title": "Status"
        },
        "statusCategory": {
          "type": "string",
          "title": "Status category",
          "enum": [
            "triage",
            "live",
            "learning",
            "paused",
            "closed",
            "declined",
            "canceled",
            "merged"
          ],
          "enumColors": {
            "triage": "yellow",
            "live": "red",
            "learning": "purple",
            "paused": "blue",
            "closed": "green",
            "declined": "lightGray",
            "canceled": "lightGray",
            "merged": "darkGray"
          }
        },
        "severity": {
          "type": "string",
          "title": "Severity"
        },
        "mode": {
          "type": "string",
          "title": "Mode",
          "enum": [
            "standard",
            "retrospective",
            "test",
            "tutorial"
          ],
          "enumColors": {
            "standard": "red",
            "retrospective": "blue",
            "test": "yellow",
            "tutorial": "lightGray"
          }
        },
        "visibility": {
          "type": "string",
          "title": "Visibility",
          "enum": [
            "public",
            "private"
          ],
          "enumColors": {
            "public": "green",
            "private": "purple"
          }
        },
        "incidentType": {
          "type": "string",
          "title": "Type"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "title": "Created at"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "title": "Updated at"
        },
        "lastActivityAt": {
          "type": "string",
          "format": "date-time",
          "title": "Last activity"
        },
        "slackChannel": {
          "type": "string",
          "title": "Slack channel"
        },
        "workloadMinutes": {
          "type": "number",
          "title": "Workload (minutes)"
        },
        "link": {
          "type": "string",
          "format": "url",
          "title": "incident.io link"
        },
        "postmortemUrl": {
          "type": "string",
          "format": "url",
          "title": "Postmortem"
        }
      },
      "required": []
    },
