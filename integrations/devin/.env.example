OCEAN__PORT__CLIENT_ID=<port_client_id>
OCEAN__PORT__CLIENT_SECRET=<port_client_secret>
# Each running instance needs its own identifier: it scopes the
# `port:pending:<identifier>` tag the session tracker polls for.
OCEAN__INTEGRATION__IDENTIFIER=devin
OCEAN__PORT__BASE_URL=https://api.getport.io
OCEAN__EVENT_LISTENER__TYPE=POLLING
OCEAN__INITIALIZE_PORT_RESOURCES=true
# Required for the actions and for the session tracker that completes their runs.
OCEAN__ACTIONS_PROCESSOR__ENABLED=true
OCEAN__INTEGRATION__CONFIG__DEVIN_API_KEY=<devin_service_user_key_cog_...>
OCEAN__INTEGRATION__CONFIG__DEVIN_ORG_ID=<devin_org_id>
OCEAN__INTEGRATION__CONFIG__DEVIN_API_HOST=https://api.devin.ai
OCEAN__INTEGRATION__CONFIG__SESSION_TRACKING_INTERVAL_SECONDS=30
OCEAN__INTEGRATION__CONFIG__SESSION_TRACKING_MAX_HOURS=72
