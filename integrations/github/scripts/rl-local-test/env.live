# Pod 3 — live events / webhooks (sync tier HIGH). Needs reachable OCEAN__BASE_URL + Port org live-events flags.
# Usage: set -a && source scripts/rl-local-test/env.live && set +a && ocean sail

OCEAN__PORT__CLIENT_ID=<port-client-id>
OCEAN__PORT__CLIENT_SECRET=<port-client-secret>
OCEAN__PORT__BASE_URL=https://api.getport.io

OCEAN__INTEGRATION__TYPE=github
OCEAN__INTEGRATION__IDENTIFIER=github-rl-test-local

OCEAN__INTEGRATION__CONFIG__GITHUB_TOKEN=<github-pat-or-app-token>
OCEAN__INTEGRATION__CONFIG__GITHUB_ORGANIZATION=<github-org>
OCEAN__INTEGRATION__CONFIG__WEBHOOK_SECRET=<webhook-secret>

# Public URL GitHub webhooks hit (ngrok/cloudflared). Must match registered webhook target in .env.live
OCEAN__BASE_URL=https://<your-tunnel-host>
OCEAN__INITIALIZE_PORT_RESOURCES=false
OCEAN__RUNTIME=OnPrem

OCEAN__EVENT_LISTENER__TYPE=WEBHOOKS_ONLY

OCEAN__INTEGRATION__INCREMENTAL_SYNC_ENABLED=false

OCEAN__CENTRALIZED_RATE_LIMITER__ENABLED=true
OCEAN__CENTRALIZED_RATE_LIMITER__REDIS__URL=redis://localhost:6379

OCEAN__LIVE_EVENTS__IS_REDIS_STREAM_CONSUMER_ENABLED=true
OCEAN__LIVE_EVENTS__REDIS__URL=redis://localhost:6379
OCEAN__LIVE_EVENTS__PAYLOAD_LOGGING_ENABLED=false

LOGURU_LEVEL=DEBUG
