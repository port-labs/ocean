# Copy values into each pod env file. All four pods MUST share identifier + GitHub creds + Redis.

OCEAN__PORT__CLIENT_ID=<port-client-id>
OCEAN__PORT__CLIENT_SECRET=<port-client-secret>
OCEAN__PORT__BASE_URL=https://api.getport.io

OCEAN__INTEGRATION__TYPE=github
OCEAN__INTEGRATION__IDENTIFIER=github-rl-test-local

OCEAN__INTEGRATION__CONFIG__GITHUB_TOKEN=<github-pat-or-app-token>
OCEAN__INTEGRATION__CONFIG__GITHUB_ORGANIZATION=<github-org>
OCEAN__INTEGRATION__CONFIG__WEBHOOK_SECRET=<webhook-secret>

OCEAN__INITIALIZE_PORT_RESOURCES=false
OCEAN__RUNTIME=OnPrem

# Centralized rate limiter (all pods)
OCEAN__CENTRALIZED_RATE_LIMITER__ENABLED=true
OCEAN__CENTRALIZED_RATE_LIMITER__REDIS__URL=redis://localhost:6379

# Verbose logs for paste-and-analyze runs
LOGURU_LEVEL=DEBUG
