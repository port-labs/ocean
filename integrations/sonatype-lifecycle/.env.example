OCEAN__PORT__CLIENT_ID=<port_client_id>
OCEAN__PORT__CLIENT_SECRET=<port_client_secret>
OCEAN__INTEGRATION__IDENTIFIER=sonatype-lifecycle
OCEAN__PORT__BASE_URL=https://api.getport.io
OCEAN__EVENT_LISTENER__TYPE=POLLING
OCEAN__INITIALIZE_PORT_RESOURCES=true

# Integration config (Ocean maps these env vars to camelCase fields in .port/spec.yaml)
OCEAN__INTEGRATION__CONFIG__IQ_SERVER_URL=https://iq.example.com
OCEAN__INTEGRATION__CONFIG__IQ_USERNAME=svc-port
OCEAN__INTEGRATION__CONFIG__IQ_USER_TOKEN=<iq_user_token>

# Optional: HMAC-SHA1 verification for IQ webhooks
# OCEAN__INTEGRATION__CONFIG__WEBHOOK_SECRET=<shared_secret>

# Optional: public base URL printed at startup for webhook registration
# Prefer OCEAN__BASE_URL in deployed environments that need live events
# OCEAN__INTEGRATION__CONFIG__APP_HOST=https://sonatype-lifecycle.example.com
# OCEAN__BASE_URL=https://sonatype-lifecycle.example.com
