  {
    "identifier": "linearDocument",
    "title": "Linear Document",
    "icon": "Linear",
    "description": "A Linear document such as a spec or PRD",
    "schema": {
      "properties": {
        "url": {
          "title": "Document URL",
          "type": "string",
          "format": "url",
          "description": "URL to the document in Linear"
