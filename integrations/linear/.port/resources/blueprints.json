          "description": "The Linear initiative this document belongs to"
        },
        "cycle": {
          "title": "Cycle",
          "type": "number",
          "description": "The Linear cycle number this document belongs to"
        },
        "creator": {
          "title": "Creator",
          "type": "string",
          "format": "user",
          "description": "The user that created the document"
        },
        "owner": {
          "title": "Owner",
          "type": "string",
          "format": "user",
          "description": "The user that owns the document"
        },
        "created": {
          "title": "Created At",
          "type": "string",
          "format": "date-time",
          "description": "The created datetime of the document"
        },
        "updated": {
          "title": "Updated At",
          "type": "string",
          "format": "date-time",
          "description": "The updated datetime of the document"
        }
      }
