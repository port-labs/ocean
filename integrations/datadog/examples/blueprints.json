[
  {
    "identifier": "datadogServiceMetric",
    "description": "This blueprint represents a Datadog service metric",
    "title": "Datadog Service Metric",
    "icon": "Datadog",
    "schema": {
      "properties": {
        "query": {
          "type": "string",
          "title": "Query",
          "description": "The Datadog query used to retrieve this metric"
        },
        "series": {
          "type": "array",
          "title": "Series",
          "description": "Array containing detailed information about the metric series"
        },
        "res_type": {
          "type": "string",
          "title": "Response Type",
          "description": "The type of response from the Datadog API"
        },
        "from_date": {
          "type": "string",
          "format": "date-time",
          "title": "From Date",
          "description": "Unix timestamp of the start of the queried time period"
        },
        "to_date": {
          "type": "string",
          "format": "date-time",
          "title": "To Date",
          "description": "Unix timestamp of the end of the queried time period"
        },
        "env": {
          "type": "string",
          "title": "Environment",
          "description": "The environment of the service"
        }
      },
      "required": []
    },
    "mirrorProperties": {},
    "calculationProperties": {},
    "relations": {
      "service": {
        "title": "Service",
        "description": "The service associated with this query",
        "target": "datadogService",
        "required": false,
        "many": false
      }
    }
  },
  {
    "identifier": "datadogSloHistory",
    "description": "This blueprint represents a datadog SLO history",
    "title": "Datadog SLO History",
    "icon": "Datadog",
    "schema": {
      "properties": {
        "monitor_type": {
          "icon": "DefaultProperty",
          "title": "Type",
          "type": "string"
        },
        "sliValue": {
          "icon": "DefaultProperty",
          "title": "SLI Value",
          "type": "number"
        },
        "sampling_start_date": {
          "icon": "DefaultProperty",
          "type": "string",
          "title": "Sampling Start Date",
          "format": "date-time"
        },
        "sampling_end_date": {
          "icon": "DefaultProperty",
          "type": "string",
          "title": "Sampling End Date",
          "format": "date-time"
        },
        "timeframe": {
          "type": "number",
          "title": "Timeframe",
          "enum": [
            7,
            30
          ],
          "enumColors": {
            "7": "purple",
            "30": "pink"
          }
        }
      },
      "required": []
    },
    "mirrorProperties": {
      "slo_target": {
        "title": "SLO Target",
        "path": "slo.targetThreshold"
      },
      "slo_warning_threshold": {
        "title": "SLO Warning Threshold",
        "path": "slo.warningThreshold"
      }
    },
    "calculationProperties": {},
    "aggregationProperties": {},
    "relations": {
      "slo": {
        "title": "SLO",
        "description": "The SLO to which this history belongs to",
        "target": "datadogSlo",
        "required": false,
        "many": false
      }
    }
  },
  {
    "identifier": "datadogService",
    "description": "This blueprint represents a Datadog service",
    "title": "Datadog Service",
    "icon": "Datadog",
    "ownership": {
      "type": "Direct"
    },
    "schema": {
      "properties": {
        "application": {
          "title": "Application",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Tags"
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "type": {
          "title": "Type",
          "type": "string",
          "enum": [
            "web",
            "db",
            "custom",
            "cache",
            "function",
            "browser",
            "mobile"
          ],
          "enumColors": {
            "web": "lightGray",
            "db": "lightGray",
            "custom": "lightGray",
            "cache": "lightGray",
            "function": "lightGray",
            "browser": "lightGray",
            "mobile": "lightGray"
          }
        },
        "owners": {
          "type": "array",
          "title": "Service Owners",
          "items": {
            "type": "string"
          }
        },
        "links": {
          "title": "Service Links",
          "type": "array",
          "description": "Links to external resources and repositories",
          "items": {
            "type": "string",
            "format": "url"
          }
        }
      },
      "required": []
    },
    "mirrorProperties": {},
    "calculationProperties": {},
    "aggregationProperties": {},
    "relations": {
      "owner_team_datadog": {
        "title": "Owner Team (Datadog)",
        "target": "datadogTeam",
        "required": false,
        "many": false
      },
      "dependency": {
        "title": "Dependency",
        "target": "datadogServiceDependency",
        "required": false,
        "many": false
      }
    }
  },
  {
    "identifier": "datadogServiceDependency",
    "description": "This blueprint represents a Datadog service-to-service dependency",
    "title": "Datadog Service Dependency",
    "icon": "Datadog",
    "schema": {
      "properties": {
      },
      "required": []
    },
    "mirrorProperties": {},
    "calculationProperties": {},
    "aggregationProperties": {},
    "relations": {
      "dependencies": {
        "title": "Depends on",
        "description": "The services called by the source service",
        "target": "datadogService",
        "required": false,
        "many": true
      }
    }
  },
  {
    "identifier": "datadogCatalogEntity",
    "description": "This blueprint represents an entity of any kind in the Datadog Software Catalog",
    "title": "Datadog Catalog Entity",
    "icon": "Datadog",
    "schema": {
      "properties": {
        "kind": {
          "type": "string",
          "title": "Kind",
          "description": "The entity kind, e.g. service, datastore, queue, api, system"
        },
        "namespace": {
          "type": "string",
          "title": "Namespace",
          "description": "The namespace the entity name is unique within"
        },
        "description": {
          "type": "string",
          "title": "Description"
        },
        "owner": {
          "type": "string",
          "title": "Owner",
          "description": "Handle of the team that owns the entity"
        },
        "type": {
          "type": "string",
          "title": "Type"
        },
        "tier": {
          "type": "string",
          "title": "Tier",
          "description": "How important the entity is to the business"
        },
        "lifecycle": {
          "type": "string",
          "title": "Lifecycle",
          "description": "The entity's lifecycle state, e.g. production, experimental"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Languages"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Tags"
        },
        "emailContacts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Email Contacts",
          "description": "Contacts declared on the entity with type email"
        },
        "additionalOwners": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Additional Owners",
          "description": "Names of the additional owner teams declared on the entity"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "url"
          },
          "title": "Links",
          "description": "Links to external resources and repositories"
        },
        "ingestionSource": {
          "type": "string",
          "title": "Ingestion Source",
          "description": "How the entity reached the catalog, e.g. api for a declared entity"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "title": "Created At"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "title": "Updated At"
        }
      },
      "required": []
    },
    "mirrorProperties": {},
    "calculationProperties": {},
    "aggregationProperties": {},
    "relations": {
      "dependsOn": {
        "target": "datadogCatalogEntity",
        "title": "Depends On",
        "description": "Entities this entity declares a dependency on",
        "many": true,
        "required": false
      },
      "componentOf": {
        "target": "datadogCatalogEntity",
        "title": "Component Of",
        "description": "Entities this entity is a component of",
        "many": true,
        "required": false
      },
      "components": {
        "target": "datadogCatalogEntity",
        "title": "Components",
        "description": "Entities a system declares in spec.components. Empty when membership is declared the other way round, as componentOf on each child",
        "many": true,
        "required": false
      },
      "implementedBy": {
        "target": "datadogCatalogEntity",
        "title": "Implemented By",
        "description": "Entities that implement this entity",
        "many": true,
        "required": false
      },
      "team": {
        "target": "datadogTeam",
        "title": "Team",
        "many": false,
        "required": false
      }
    }
  }
]
