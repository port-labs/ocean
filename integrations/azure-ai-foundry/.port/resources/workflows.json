[
  {
    "identifier": "foundry_deploy_model_wf",
    "title": "Deploy Foundry model",
    "icon": "Deployment",
    "category": "Azure AI Foundry",
    "description": "Deploy a model deployment in the configured Foundry project.",
    "allowAnyoneToViewRuns": true,
    "nodes": [
      {
        "identifier": "trigger",
        "title": "Deploy Foundry model",
        "icon": "Deployment",
        "description": "Deploy a model deployment in your Foundry project.",
        "config": {
          "type": "SELF_SERVE_TRIGGER",
          "published": true,
          "userInputs": {
            "properties": {
              "deploymentName": {
                "type": "string",
                "title": "Deployment name",
                "description": "Foundry deployment name (catalog identifier)."
              },
              "modelName": {
                "type": "string",
                "title": "Model name",
                "description": "Publisher model id (for example gpt-5)."
              },
              "modelVersion": {
                "type": "string",
                "title": "Model version"
              },
              "modelPublisher": {
                "type": "string",
                "title": "Model publisher"
              },
              "skuName": {
                "type": "string",
                "title": "SKU",
                "enum": ["GlobalStandard", "Standard", "DataZoneStandard"],
                "default": "GlobalStandard"
              }
            },
            "required": ["deploymentName", "modelName"],
            "order": [
              "deploymentName",
              "modelName",
              "modelVersion",
              "modelPublisher",
              "skuName"
            ]
          }
        }
      },
      {
        "identifier": "deploy_model",
        "title": "Deploy model",
        "icon": "Azure",
        "config": {
          "type": "INTEGRATION_ACTION",
          "installationId": "azure-ai-foundry",
          "integrationProvider": "azure-ai-foundry",
          "integrationInvocationType": "deploy_model_deployment",
          "integrationActionExecutionProperties": {
            "deploymentName": "{{ .outputs.trigger.deploymentName }}",
            "modelName": "{{ .outputs.trigger.modelName }}",
            "modelVersion": "{{ .outputs.trigger.modelVersion }}",
            "modelPublisher": "{{ .outputs.trigger.modelPublisher }}",
            "skuName": "{{ .outputs.trigger.skuName }}"
          },
          "onFailure": "terminate"
        },
        "variables": {},
        "verbose": false
      }
    ],
    "connections": [
      {
        "sourceIdentifier": "trigger",
        "targetIdentifier": "deploy_model"
      }
    ]
  },
  {
    "identifier": "foundry_delete_deployment_wf",
    "title": "Delete Foundry deployment",
    "icon": "Delete",
    "category": "Azure AI Foundry",
    "description": "Delete a model deployment from Foundry and the catalog.",
    "allowAnyoneToViewRuns": true,
    "nodes": [
      {
        "identifier": "trigger",
        "title": "Delete Foundry deployment",
        "icon": "Delete",
        "description": "Remove a synced model deployment from Foundry.",
        "config": {
          "type": "SELF_SERVE_TRIGGER",
          "published": true,
          "variant": "ALERT",
          "contexts": [{ "on": "ENTITY", "userInput": "deployment" }],
          "userInputs": {
            "properties": {
              "deployment": {
                "type": "string",
                "format": "entity",
                "blueprint": "foundry_model_deployment",
                "title": "Model deployment"
              }
            },
            "required": ["deployment"],
            "order": ["deployment"]
          }
        }
      },
      {
        "identifier": "delete_deployment",
        "title": "Delete deployment",
        "icon": "Azure",
        "config": {
          "type": "INTEGRATION_ACTION",
          "installationId": "azure-ai-foundry",
          "integrationProvider": "azure-ai-foundry",
          "integrationInvocationType": "delete_model_deployment",
          "integrationActionExecutionProperties": {
            "deploymentName": "{{ .outputs.trigger.deployment }}"
          },
          "onFailure": "terminate"
        },
        "variables": {},
        "verbose": false
      }
    ],
    "connections": [
      {
        "sourceIdentifier": "trigger",
        "targetIdentifier": "delete_deployment"
      }
    ]
  },
  {
    "identifier": "foundry_create_agent_wf",
    "title": "Create Foundry agent",
    "icon": "AddUser",
    "category": "Azure AI Foundry",
    "description": "Create a new Foundry agent in the configured project.",
    "allowAnyoneToViewRuns": true,
    "nodes": [
      {
        "identifier": "trigger",
        "title": "Create Foundry agent",
        "icon": "AddUser",
        "description": "Register a new agent in Foundry.",
        "config": {
          "type": "SELF_SERVE_TRIGGER",
          "published": true,
          "contexts": [
            { "on": "CREATE_ENTITY", "blueprintIdentifier": "foundry_agent" }
          ],
          "userInputs": {
            "properties": {
              "name": {
                "type": "string",
                "title": "Agent name"
              },
              "model": {
                "type": "string",
                "format": "entity",
                "blueprint": "foundry_model_deployment",
                "title": "Model deployment"
              },
              "instructions": {
                "type": "string",
                "title": "Instructions"
              }
            },
            "required": ["name", "model"],
            "order": ["name", "model", "instructions"]
          }
        }
      },
      {
        "identifier": "create_agent",
        "title": "Create agent",
        "icon": "Azure",
        "config": {
          "type": "INTEGRATION_ACTION",
          "installationId": "azure-ai-foundry",
          "integrationProvider": "azure-ai-foundry",
          "integrationInvocationType": "create_agent",
          "integrationActionExecutionProperties": {
            "name": "{{ .outputs.trigger.name }}",
            "model": "{{ .outputs.trigger.model }}",
            "instructions": "{{ .outputs.trigger.instructions }}",
            "enablePortMcp": true
          },
          "onFailure": "terminate"
        },
        "variables": {},
        "verbose": false
      }
    ],
    "connections": [
      {
        "sourceIdentifier": "trigger",
        "targetIdentifier": "create_agent"
      }
    ]
  },
  {
    "identifier": "foundry_delete_agent_wf",
    "title": "Delete Foundry agent",
    "icon": "Delete",
    "category": "Azure AI Foundry",
    "description": "Delete a Foundry agent from the project and catalog.",
    "allowAnyoneToViewRuns": true,
    "nodes": [
      {
        "identifier": "trigger",
        "title": "Delete Foundry agent",
        "icon": "Delete",
        "description": "Permanently delete a Foundry agent.",
        "config": {
          "type": "SELF_SERVE_TRIGGER",
          "published": true,
          "variant": "ALERT",
          "contexts": [{ "on": "ENTITY", "userInput": "agent" }],
          "userInputs": {
            "properties": {
              "agent": {
                "type": "string",
                "format": "entity",
                "blueprint": "foundry_agent",
                "title": "Agent"
              }
            },
            "required": ["agent"],
            "order": ["agent"]
          }
        }
      },
      {
        "identifier": "delete_agent",
        "title": "Delete agent",
        "icon": "Azure",
        "config": {
          "type": "INTEGRATION_ACTION",
          "installationId": "azure-ai-foundry",
          "integrationProvider": "azure-ai-foundry",
          "integrationInvocationType": "delete_agent",
          "integrationActionExecutionProperties": {
            "agentId": "{{ .outputs.trigger.agent }}"
          },
          "onFailure": "terminate"
        },
        "variables": {},
        "verbose": false
      }
    ],
    "connections": [
      {
        "sourceIdentifier": "trigger",
        "targetIdentifier": "delete_agent"
      }
    ]
  },
  {
    "identifier": "foundry_update_agent_wf",
    "title": "Update Foundry agent",
    "icon": "Edit",
    "category": "Azure AI Foundry",
    "description": "Update name, model, or instructions for a Foundry agent.",
    "allowAnyoneToViewRuns": true,
    "nodes": [
      {
        "identifier": "trigger",
        "title": "Update Foundry agent",
        "icon": "Edit",
        "description": "Change name, model, or instructions for an agent.",
        "config": {
          "type": "SELF_SERVE_TRIGGER",
          "published": true,
          "contexts": [{ "on": "ENTITY", "userInput": "agent" }],
          "userInputs": {
            "properties": {
              "agent": {
                "type": "string",
                "format": "entity",
                "blueprint": "foundry_agent",
                "title": "Agent"
              },
              "name": {
                "type": "string",
                "title": "New name"
              },
              "model": {
                "type": "string",
                "format": "entity",
                "blueprint": "foundry_model_deployment",
                "title": "Model deployment"
              },
              "instructions": {
                "type": "string",
                "title": "Instructions"
              }
            },
            "required": ["agent"],
            "order": ["agent", "name", "model", "instructions"]
          }
        }
      },
      {
        "identifier": "update_agent",
        "title": "Update agent",
        "icon": "Azure",
        "config": {
          "type": "INTEGRATION_ACTION",
          "installationId": "azure-ai-foundry",
          "integrationProvider": "azure-ai-foundry",
          "integrationInvocationType": "update_agent",
          "integrationActionExecutionProperties": {
            "agentId": "{{ .outputs.trigger.agent }}",
            "name": "{{ .outputs.trigger.name }}",
            "model": "{{ .outputs.trigger.model }}",
            "instructions": "{{ .outputs.trigger.instructions }}"
          },
          "onFailure": "terminate"
        },
        "variables": {},
        "verbose": false
      }
    ],
    "connections": [
      {
        "sourceIdentifier": "trigger",
        "targetIdentifier": "update_agent"
      }
    ]
  },
  {
    "identifier": "foundry_invoke_agent_wf",
    "title": "Invoke Foundry agent",
    "icon": "Chat",
    "category": "Azure AI Foundry",
    "description": "Send a message to a Foundry agent via the Responses API.",
    "allowAnyoneToViewRuns": true,
    "nodes": [
      {
        "identifier": "trigger",
        "title": "Invoke Foundry agent",
        "icon": "Chat",
        "description": "Send a prompt to an agent via the Responses API.",
        "config": {
          "type": "SELF_SERVE_TRIGGER",
          "published": true,
          "contexts": [{ "on": "ENTITY", "userInput": "agent" }],
          "userInputs": {
            "properties": {
              "agent": {
                "type": "string",
                "format": "entity",
                "blueprint": "foundry_agent",
                "title": "Agent"
              },
              "input": {
                "type": "string",
                "title": "Message"
              },
              "conversationId": {
                "type": "string",
                "title": "Conversation ID",
                "description": "Optional; reuse a prior invoke run conversationId to continue multi-turn history."
              }
            },
            "required": ["agent", "input"],
            "order": ["agent", "input", "conversationId"]
          }
        }
      },
      {
        "identifier": "invoke_agent",
        "title": "Invoke agent",
        "icon": "Azure",
        "config": {
          "type": "INTEGRATION_ACTION",
          "installationId": "azure-ai-foundry",
          "integrationProvider": "azure-ai-foundry",
          "integrationInvocationType": "invoke_agent",
          "integrationActionExecutionProperties": {
            "agentId": "{{ .outputs.trigger.agent }}",
            "input": "{{ .outputs.trigger.input }}",
            "conversationId": "{{ .outputs.trigger.conversationId }}",
            "enablePortMcp": true,
            "reportInvocationStatus": true
          },
          "executionIdentity": {
            "type": "actor"
          },
          "onFailure": "terminate"
        },
        "variables": {},
        "verbose": false
      }
    ],
    "connections": [
      {
        "sourceIdentifier": "trigger",
        "targetIdentifier": "invoke_agent"
      }
    ]
  }
]
