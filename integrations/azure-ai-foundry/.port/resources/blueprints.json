[
    {
        "identifier": "foundry_agent",
        "title": "Foundry Agent",
        "description": "A Microsoft Foundry agent in the configured project (Agent Control Plane registry row).",
        "icon": "Azure",
        "schema": {
            "properties": {
                "kind": {
                    "type": "string",
                    "title": "Agent kind",
                    "description": "Agent type from the active version (prompt, hosted, container_app, workflow)."
                },
                "model": {
                    "type": "string",
                    "title": "Model",
                    "description": "Model deployment name used by the active agent version."
                },
                "instructions": {
                    "type": "string",
                    "title": "Instructions",
                    "description": "System instructions for the agent."
                },
                "status": {
                    "type": "string",
                    "title": "Status",
                    "description": "Top-level agent state (for example enabled)."
                },
                "configurationState": {
                    "type": "string",
                    "title": "Configuration state",
                    "description": "Whether agent configuration is enabled in Foundry."
                },
                "version": {
                    "type": "string",
                    "title": "Active version",
                    "description": "Published version number of the latest agent version."
                },
                "versionStatus": {
                    "type": "string",
                    "title": "Version status",
                    "description": "Status of the latest version (for example active)."
                },
                "agentGuid": {
                    "type": "string",
                    "title": "Agent GUID",
                    "description": "Stable Foundry identifier for the agent resource."
                },
                "toolCount": {
                    "type": "number",
                    "title": "Tool count",
                    "description": "Number of tools on the active version definition."
                },
                "description": {
                    "type": "string",
                    "title": "Description",
                    "description": "Agent version description from Foundry."
                },
                "sourcePlatform": {
                    "type": "string",
                    "title": "Source platform",
                    "description": "Originating control-plane platform (default Azure AI Foundry)."
                },
                "owner": {
                    "type": "string",
                    "title": "Owner",
                    "description": "Owner from Foundry metadata (convention-based; no native owner field)."
                },
                "metadata": {
                    "type": "object",
                    "title": "Metadata",
                    "description": "Foundry metadata key-value pairs (up to 16 keys)."
                },
                "tools": {
                    "type": "array",
                    "title": "Tools",
                    "description": "Tools configured on the active agent version."
                },
                "entraPrincipalId": {
                    "type": "string",
                    "title": "Entra principal ID",
                    "description": "Microsoft Entra principal ID for the agent managed identity."
                },
                "entraClientId": {
                    "type": "string",
                    "title": "Entra client ID",
                    "description": "Microsoft Entra application (client) ID for the agent identity."
                },
                "entraIdentityStatus": {
                    "type": "string",
                    "title": "Entra identity status",
                    "description": "Status of the agent instance identity in Foundry."
                },
                "identityBlueprintId": {
                    "type": "string",
                    "title": "Identity blueprint ID",
                    "description": "Managed agent identity blueprint identifier when present."
                },
                "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "title": "Created at",
                    "description": "When the active version was created."
                },
                "updatedAt": {
                    "type": "string",
                    "format": "date-time",
                    "title": "Updated at",
                    "description": "When the agent was last updated, if reported."
                },
                "metricsInputTokens": {
                    "type": "number",
                    "title": "Input tokens (window)",
                    "description": "Sum of AgentInputTokens for the observability window."
                },
                "metricsOutputTokens": {
                    "type": "number",
                    "title": "Output tokens (window)",
                    "description": "Sum of AgentOutputTokens for the observability window."
                },
                "metricsResponses": {
                    "type": "number",
                    "title": "Responses (window)",
                    "description": "Sum of AgentResponses for the observability window."
                },
                "metricsRuns": {
                    "type": "number",
                    "title": "Runs (window)",
                    "description": "Sum of AgentRuns for the observability window."
                },
                "metricsToolCalls": {
                    "type": "number",
                    "title": "Tool calls (window)",
                    "description": "Sum of AgentToolCalls for the observability window."
                },
                "metricsEstimatedCostUsd": {
                    "type": "number",
                    "title": "Estimated cost USD (window)",
                    "description": "Sum of AgentModelEstimatedCost for the observability window."
                },
                "metricsWindowDays": {
                    "type": "number",
                    "title": "Metrics window (days)",
                    "description": "Lookback window used for observability totals."
                },
                "metricsAsOf": {
                    "type": "string",
                    "format": "date-time",
                    "title": "Metrics as of",
                    "description": "When observability totals were fetched during resync."
                }
            },
            "required": []
        },
        "relations": {
            "modelDeployment": {
                "title": "Model deployment",
                "target": "foundry_model_deployment",
                "required": false,
                "many": false
            }
        }
    },
    {
