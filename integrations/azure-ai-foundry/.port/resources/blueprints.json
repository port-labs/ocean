                },
                "description": {
                    "type": "string",
                    "title": "Description"
                },
                "versionStatus": {
                    "type": "string",
                    "title": "Version status"
                },
                "isDraft": {
                    "type": "boolean",
                    "title": "Draft"
                },
                "sourcePlatform": {
                    "type": "string",
                    "title": "Source platform"
                },
                "owner": {
                    "type": "string",
                    "title": "Owner"
                },
                "metadata": {
                    "type": "object",
                    "title": "Metadata"
                },
                "tools": {
                    "type": "array",
                    "title": "Tools"
                },
                "toolCount": {
                    "type": "number",
                    "title": "Tool count"
                },
                "entraPrincipalId": {
                    "type": "string",
                    "title": "Entra principal ID"
                },
                "entraClientId": {
                    "type": "string",
                    "title": "Entra client ID"
                },
                "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "title": "Created at"
                },
                "updatedAt": {
                    "type": "string",
                    "format": "date-time",
                    "title": "Updated at"
                }
            },
            "required": []
        },
        "relations": {
            "agent": {
                "title": "Agent",
                "target": "foundry_agent",
                "required": true,
                "many": false
            }
        }
    },
    {
        "identifier": "foundry_model_deployment",
        "title": "Foundry Deployment",
        "description": "A model deployed for inference in the project (one catalog row per deployment name).",
        "icon": "Azure",
        "schema": {
            "properties": {
                "model": {
                    "type": "string",
                    "title": "Model name",
                    "description": "Publisher model id (for example gpt-5)."
                },
                "modelVersion": {
                    "type": "string",
                    "title": "Model version",
                    "description": "Publisher model version string."
                },
                "modelPublisher": {
                    "type": "string",
                    "title": "Publisher",
                    "description": "Model publisher (for example OpenAI, Microsoft)."
                },
                "deploymentType": {
                    "type": "string",
                    "title": "Deployment type",
                    "description": "Foundry deployment type (for example ModelDeployment)."
                },
                "sku": {
                    "type": "string",
                    "title": "Deployment SKU",
                    "description": "Azure capacity/pricing tier (for example GlobalStandard)."
                },
                "capabilities": {
                    "type": "object",
                    "title": "Capabilities",
                    "description": "Capability flags returned by Foundry (chat_completion, embeddings, etc.)."
                },
                "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "title": "Created at"
                },
                "updatedAt": {
                    "type": "string",
                    "format": "date-time",
                    "title": "Updated at"
                }
            },
            "required": []
        },
        "relations": {}
    },
    {
        "identifier": "foundry_conversation",
        "title": "Foundry Conversation",
        "description": "OpenAI conversation memory used with prompt and Responses agents (multi-turn chat history).",
        "icon": "Azure",
        "schema": {
            "properties": {
                "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "title": "Created at",
                    "description": "When the conversation was created."
                },
                "metadata": {
                    "type": "object",
                    "title": "Metadata",
                    "description": "Optional conversation metadata from Foundry (may include agent hints)."
                },
                "promptTokens": {
                    "type": "number",
                    "title": "Prompt tokens",
                    "description": "Summed input tokens from related responses."
                },
                "completionTokens": {
                    "type": "number",
                    "title": "Completion tokens",
                    "description": "Summed output tokens from related responses."
                },
                "totalTokens": {
                    "type": "number",
                    "title": "Total tokens",
                    "description": "Summed total tokens from related responses."
                },
                "toolCallCount": {
                    "type": "number",
                    "title": "Tool calls",
                    "description": "Tool/MCP/function calls counted across related response outputs."
                }
            },
            "required": []
        },
        "relations": {
            "agents": {
                "title": "Agents",
                "target": "foundry_agent",
                "required": false,
                "many": true
            },
            "modelDeployments": {
                "title": "Model deployments",
                "target": "foundry_model_deployment",
                "required": false,
                "many": true
            }
        }
    },
