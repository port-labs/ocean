# Azure AI Foundry Ocean integration — copy to `.env` and fill in values.

OCEAN__PORT__CLIENT_ID=
OCEAN__PORT__CLIENT_SECRET=
OCEAN__INTEGRATION__IDENTIFIER=azure-ai-foundry
OCEAN__INTEGRATION__TYPE=azure-ai-foundry
OCEAN__INTEGRATION__CONFIG__FOUNDRY_PROJECT_ENDPOINT=https://your-account.services.ai.azure.com/api/projects/your-project
OCEAN__INTEGRATION__CONFIG__AZURE_SUBSCRIPTION_ID=
OCEAN__INTEGRATION__CONFIG__AZURE_RESOURCE_GROUP_NAME=
# OCEAN__INTEGRATION__CONFIG__LOG_ANALYTICS_WORKSPACE_ID=
# Optional service principal (otherwise DefaultAzureCredential):
# OCEAN__INTEGRATION__CONFIG__AZURE_TENANT_ID=
# OCEAN__INTEGRATION__CONFIG__AZURE_CLIENT_ID=
# OCEAN__BASE_URL=https://your-public-ocean-url  # required for Foundry webhook registration
# OCEAN__INTEGRATION__CONFIG__WEBHOOK_SIGNING_SECRET=whsec_...
# OCEAN__INTEGRATION__CONFIG__VERIFY_WEBHOOK_SECRETS=false
