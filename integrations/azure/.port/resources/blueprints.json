  {
    "identifier": "foundry_agent",
    "title": "Foundry Agent",
    "description": "A Microsoft Foundry agent in the configured project (Agent Control Plane registry row).",
    "icon": "Azure",
    "schema": {
      "properties": {
        "kind": {
          "type": "string",
          "title": "Agent kind",
          "description": "Agent type from the active version (prompt, hosted, container_app, workflow)."
        },
        "model": {
          "type": "string",
          "title": "Model",
          "description": "Model deployment name used by the active agent version."
        },
        "instructions": {
          "type": "string",
          "title": "Instructions",
          "description": "System instructions for the agent."
        },
        "status": {
          "type": "string",
          "title": "Status",
          "description": "Top-level agent state (for example enabled)."
        },
        "configurationState": {
          "type": "string",
          "title": "Configuration state",
          "description": "Whether agent configuration is enabled in Foundry."
        },
        "version": {
          "type": "string",
          "title": "Active version",
          "description": "Published version number of the latest agent version."
        },
        "versionStatus": {
          "type": "string",
          "title": "Version status",
          "description": "Status of the latest version (for example active)."
        },
        "agentGuid": {
          "type": "string",
          "title": "Agent GUID",
          "description": "Stable Foundry identifier for the agent resource."
        },
        "toolCount": {
          "type": "number",
          "title": "Tool count",
          "description": "Number of tools on the active version definition."
        },
        "description": {
          "type": "string",
          "title": "Description",
          "description": "Agent version description from Foundry."
        },
        "metadata": {
          "type": "object",
          "title": "Metadata",
          "description": "Foundry metadata key-value pairs (up to 16 keys)."
        },
        "tools": {
          "type": "array",
          "title": "Tools",
          "description": "Foundry agent definition tools (MCP, function, code interpreter, etc.) synced as JSON objects.",
          "items": {
            "type": "object"
          }
        },
        "entraPrincipalId": {
          "type": "string",
          "title": "Entra principal ID",
          "description": "Microsoft Entra principal ID for the agent managed identity."
        },
        "entraClientId": {
          "type": "string",
          "title": "Entra client ID",
          "description": "Microsoft Entra application (client) ID for the agent identity."
        },
        "entraIdentityStatus": {
          "type": "string",
          "title": "Entra identity status",
          "description": "Status of the agent instance identity in Foundry."
        },
        "identityBlueprintId": {
          "type": "string",
          "title": "Identity blueprint ID",
          "description": "Managed agent identity blueprint identifier when present."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "title": "Created at",
          "description": "When the active version was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "title": "Updated at",
          "description": "When the agent was last updated, if reported."
        }
      },
      "required": []
    },
    "relations": {
      "modelDeployment": {
        "title": "Model deployment",
        "target": "foundry_model_deployment",
        "required": false,
        "many": false
      },
      "foundryProject": {
        "title": "Foundry project",
        "target": "foundry_project",
        "required": false,
        "many": false
      }
    }
  },
  {
    "identifier": "foundry_model_deployment",
    "title": "Foundry Deployment",
    "description": "A model deployed for inference in the project (one catalog row per deployment name).",
    "icon": "Azure",
    "schema": {
      "properties": {
        "model": {
          "type": "string",
          "title": "Model name",
          "description": "Publisher model id (for example gpt-5)."
        },
        "modelVersion": {
          "type": "string",
          "title": "Model version",
          "description": "Publisher model version string."
        },
        "modelPublisher": {
          "type": "string",
          "title": "Publisher",
          "description": "Model publisher (for example OpenAI, Microsoft)."
        },
        "deploymentType": {
          "type": "string",
          "title": "Deployment type",
          "description": "Foundry deployment type (for example ModelDeployment)."
        },
        "sku": {
          "type": "string",
          "title": "Deployment SKU",
          "description": "Azure capacity/pricing tier (for example GlobalStandard)."
        },
        "capabilities": {
          "type": "object",
          "title": "Capabilities",
          "description": "Capability flags returned by Foundry (chat_completion, embeddings, etc.)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "title": "Created at"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "title": "Updated at"
        }
      },
      "required": []
    },
    "relations": {
      "foundryProject": {
        "title": "Foundry project",
        "target": "foundry_project",
        "required": false,
        "many": false
      }
    }
  },
  {
    "identifier": "foundry_conversation",
    "title": "Foundry Conversation",
    "description": "Foundry conversation metadata (~30d Azure retention). Token and tool-call totals aggregate from related foundry_response entities.",
    "icon": "Azure",
    "schema": {
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "title": "Created at",
          "description": "When the conversation was created."
        },
        "metadata": {
          "type": "object",
          "title": "Metadata",
          "description": "Optional conversation metadata from Foundry (may include agent hints)."
        }
      },
      "required": []
    },
    "aggregationProperties": {
      "responseCount": {
        "title": "Response count",
        "target": "foundry_response",
        "calculationSpec": {
          "calculationBy": "entities",
          "func": "count"
        }
      },
      "totalPromptTokens": {
        "title": "Total prompt tokens",
        "target": "foundry_response",
        "calculationSpec": {
          "calculationBy": "property",
          "func": "sum",
          "property": "promptTokens"
        }
      },
      "totalCompletionTokens": {
        "title": "Total completion tokens",
        "target": "foundry_response",
        "calculationSpec": {
          "calculationBy": "property",
          "func": "sum",
          "property": "completionTokens"
        }
      },
      "totalTokens": {
        "title": "Total tokens",
        "target": "foundry_response",
        "calculationSpec": {
          "calculationBy": "property",
          "func": "sum",
          "property": "totalTokens"
        }
      },
      "totalCachedTokens": {
        "title": "Total cached tokens",
        "target": "foundry_response",
        "calculationSpec": {
          "calculationBy": "property",
          "func": "sum",
          "property": "cachedTokens"
        }
      },
      "totalReasoningTokens": {
        "title": "Total reasoning tokens",
        "target": "foundry_response",
        "calculationSpec": {
          "calculationBy": "property",
          "func": "sum",
          "property": "reasoningTokens"
        }
      },
      "totalToolCalls": {
        "title": "Total tool calls",
        "target": "foundry_response",
        "calculationSpec": {
          "calculationBy": "property",
          "func": "sum",
          "property": "toolCallCount"
        }
      }
    },
    "relations": {
      "foundryProject": {
        "title": "Foundry project",
        "target": "foundry_project",
        "required": false,
        "many": false
      }
    }
  },
  {
    "identifier": "foundry_response",
    "title": "Foundry Response",
    "description": "A single Foundry Responses API run (resp_*) with token usage metrics. Response records in Azure are typically available for about 30 days; use sync soon after runs if you need them in the catalog.",
    "icon": "Azure",
    "schema": {
      "properties": {
        "status": {
          "type": "string",
          "title": "Status",
          "description": "Terminal or in-progress response status from Foundry."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "title": "Created at"
        },
        "promptTokens": {
          "type": "number",
          "title": "Prompt tokens"
        },
        "completionTokens": {
          "type": "number",
          "title": "Completion tokens"
        },
        "totalTokens": {
          "type": "number",
          "title": "Total tokens"
        },
        "cachedTokens": {
          "type": "number",
          "title": "Cached tokens",
          "description": "Prompt-cache read tokens (subset of input tokens)."
        },
        "reasoningTokens": {
          "type": "number",
          "title": "Reasoning tokens",
          "description": "Hidden reasoning tokens (subset of output tokens)."
        },
        "toolCalls": {
          "type": "array",
          "title": "Tool calls",
          "description": "Tool/MCP/function call items from the response output (excludes messages and mcp_list_tools).",
          "items": {
            "type": "object"
          }
        }
      },
      "required": []
    },
    "calculationProperties": {
      "toolCallCount": {
        "title": "Tool call count",
        "type": "number",
        "calculation": "(.properties.toolCalls // []) | length"
      }
    },
    "relations": {
      "conversation": {
        "title": "Conversation",
        "target": "foundry_conversation",
        "required": false,
        "many": false
      }
    }
  },
