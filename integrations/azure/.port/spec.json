{
  "title": "Azure",
  "description": "Azure integration for Port Ocean, including Azure Resource Manager resources and auto-discovered Azure AI Foundry projects.",
  "icon": "Azure",
  "docs": "https://docs.port.io/build-your-software-catalog/sync-data-to-catalog/cloud-providers/azure",
  "formMappingEnabled": true,
  "features": [
    {
      "type": "exporter",
      "section": "Cloud Providers",
      "resources": [
        {
          "kind": "resourceGroup"
        },
        {
          "kind": "containerApp"
        },
        {
          "kind": "aks"
        },
        {
          "kind": "storageAccount"
        },
        {
          "kind": "virtualMachine"
        },
        {
          "kind": "storageContainer"
        }
      ]
    },
    {
      "type": "exporter",
      "section": "AI Agents",
      "resources": [
        {
          "kind": "Microsoft.CognitiveServices/accounts/projects"
        },
        {
          "kind": "foundry-agent"
        },
        {
          "kind": "foundry-agent-version"
        },
        {
          "kind": "foundry-model-deployment"
        },
        {
          "kind": "foundry-conversation"
        },
        {
          "kind": "foundry-response"
        },
        {
          "kind": "foundry-memory-store"
        }
      ]
    }
  ],
  "saas": {
    "enabled": true,
    "liveEvents": {
      "enabled": true
    },
    "incrementalSync": {
      "enabled": true
    }
  },
  "configurations": [
    {
      "name": "azureClientId",
      "required": false,
      "type": "string",
      "sensitive": true,
      "description": "Azure Client ID. For more information on how to create and manage credentials, see the <a href=\"https://docs.microsoft.com/en-us/azure/active-directory/develop/howto-create-service-principal-portal\" target=\"_blank\">Azure documentation</a>."
    },
    {
      "name": "azureClientSecret",
      "required": false,
      "type": "string",
      "sensitive": true,
      "description": "Azure Client Secret. For more information on how to create and manage credentials, see the <a href=\"https://docs.microsoft.com/en-us/azure/active-directory/develop/howto-create-service-principal-portal\" target=\"_blank\">Azure documentation</a>."
    },
    {
      "name": "azureTenantId",
      "required": false,
      "type": "string",
      "sensitive": true,
      "description": "Azure Tenant ID. For more information on how to create and manage credentials, see the <a href=\"https://docs.microsoft.com/en-us/azure/active-directory/develop/howto-create-service-principal-portal\" target=\"_blank\">Azure documentation</a>"
    }
  ],
  "deploymentMethodRequirements": [
    {
      "type": "default",
      "configurations": [
        "azureClientId",
        "azureClientSecret",
        "azureTenantId"
      ]
    }
  ],
  "deploymentMethodOverride": [
    {
      "type": "helm"
    },
    {
      "type": "docker"
    },
    {
      "type": "githubWorkflow"
    },
    {
      "type": "gitlabCI"
    },
    {
      "type": "terraform",
      "module": "port-labs/integration-factory/ocean",
      "example": "azure_container_app_azure_integration",
      "title": "Azure Container App",
      "version": ">=0.0.25",
      "extraVars": [
        {
          "name": "event_grid_system_topic_name",
          "description": "The name of the event grid system topic of type Microsoft.Resources.Subscriptions to use to receive events from Azure. If not set, a new topic will be created. Note that Azure supports only one Microsoft.Resources.Subscriptions topic in account.",
          "required": true,
          "default": "",
          "type": "string"
        },
        {
          "name": "included_event_types",
          "description": "A list of resources to filter events from Azure.",
          "required": true,
          "default": [
            "Microsoft.Resources/subscriptions/resourceGroups",
            "Microsoft.App/containerApp",
            "Microsoft.Storage/storageAccounts",
            "Microsoft.Compute/virtualMachines",
            "Microsoft.ContainerService/managedClusters",
            "Microsoft.Network/loadBalancers",
            "Microsoft.Network/virtualNetworks"
          ],
          "type": "array"
        },
        {
          "name": "action_permissions_list",
          "description": "A list of permissions that will be assigned to the Azure Integration User to export Azure Resources.",
          "required": true,
          "default": [
            "Microsoft.Resources/subscriptions/read",
            "Microsoft.Resources/subscriptions/resourceGroups/read",
            "Microsoft.Resources/subscriptions/resources/read",
            "*/read"
          ],
          "type": "array"
        }
      ]
    }
  ],
  "actionsProcessingEnabled": true,
  "actions": [
    {
      "name": "create_agent",
      "icon": "Azure",
      "description": "Create a Foundry agent in the configured project",
      "inputs": [
        {
          "name": "projectEndpoint",
          "title": "Foundry project endpoint",
          "type": "string",
          "required": true,
          "description": "Foundry project data-plane URL, e.g. https://<account>.services.ai.azure.com/api/projects/<project>."
        },
        {
          "name": "name",
          "title": "Name",
          "type": "string",
          "required": true
        },
        {
          "name": "model",
          "title": "Model deployment",
          "type": "string",
          "required": true
        },
        {
          "name": "instructions",
          "title": "Instructions",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "update_agent",
      "icon": "Azure",
      "description": "Update a Foundry agent",
      "inputs": [
        {
          "name": "projectEndpoint",
          "title": "Foundry project endpoint",
          "type": "string",
          "required": true,
          "description": "Foundry project data-plane URL, e.g. https://<account>.services.ai.azure.com/api/projects/<project>."
        },
        {
          "name": "agentId",
          "title": "Agent ID",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "title": "Name",
          "type": "string",
          "required": false
        },
        {
          "name": "model",
          "title": "Model deployment",
          "type": "string",
          "required": false
        },
        {
          "name": "instructions",
          "title": "Instructions",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "delete_agent",
      "icon": "Azure",
      "description": "Delete a Foundry agent",
      "inputs": [
        {
          "name": "projectEndpoint",
          "title": "Foundry project endpoint",
          "type": "string",
          "required": true,
          "description": "Foundry project data-plane URL, e.g. https://<account>.services.ai.azure.com/api/projects/<project>."
        },
        {
          "name": "agentId",
          "title": "Agent ID",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "deploy_model_deployment",
      "icon": "Azure",
      "description": "Deploy a model in the configured Foundry project",
      "inputs": [
        {
          "name": "projectEndpoint",
          "title": "Foundry project endpoint",
          "type": "string",
          "required": true,
          "description": "Foundry project data-plane URL, e.g. https://<account>.services.ai.azure.com/api/projects/<project>."
        },
        {
          "name": "deploymentName",
          "title": "Deployment name",
          "type": "string",
          "required": true
        },
        {
          "name": "modelName",
          "title": "Model name",
          "type": "string",
          "required": true
        },
        {
          "name": "modelVersion",
          "title": "Model version",
          "type": "string",
          "required": false
        },
        {
          "name": "modelPublisher",
          "title": "Model publisher",
          "type": "string",
          "required": false
        },
        {
          "name": "skuName",
          "title": "SKU name",
          "type": "string",
          "required": false,
          "default": "GlobalStandard"
        },
        {
          "name": "deploymentType",
          "title": "Deployment type",
          "type": "string",
          "required": false,
          "default": "ModelDeployment"
        }
      ]
    },
    {
      "name": "delete_model_deployment",
      "icon": "Azure",
      "description": "Delete a model deployment from the configured Foundry project",
      "inputs": [
        {
          "name": "projectEndpoint",
          "title": "Foundry project endpoint",
          "type": "string",
          "required": true,
          "description": "Foundry project data-plane URL, e.g. https://<account>.services.ai.azure.com/api/projects/<project>."
        },
        {
          "name": "deploymentName",
          "title": "Deployment name",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "invoke_agent",
      "icon": "Azure",
      "description": "Invoke a Foundry agent via the Responses API",
      "inputs": [
        {
          "name": "projectEndpoint",
          "title": "Foundry project endpoint",
          "type": "string",
          "required": true,
          "description": "Foundry project data-plane URL, e.g. https://<account>.services.ai.azure.com/api/projects/<project>."
        },
        {
          "name": "agentId",
          "title": "Agent ID",
          "type": "string",
          "required": true
        },
        {
          "name": "input",
          "title": "Input",
          "type": "string",
          "required": true
        },
        {
          "name": "conversationId",
          "title": "Conversation ID",
          "type": "string",
          "required": false,
          "description": "Optional Foundry conversation ID to continue multi-turn chat history. When omitted, a new conversation is created for the invoke."
        },
        {
          "name": "conversationMetadata",
          "title": "Conversation metadata",
          "type": "jqObject",
          "required": false,
          "description": "Optional metadata to set on the conversation before invoke (for example subject, ticket id, or owner). Applied on create when conversationId is omitted, or patched onto an existing conversationId."
        },
        {
          "name": "reportInvocationStatus",
          "title": "Report invocation status",
          "type": "boolean",
          "required": false,
          "default": true,
          "description": "When true, keeps the run open until a terminal Foundry response.* webhook completes it (requires OCEAN__BASE_URL and a registered Foundry webhook). Falls back to SSE terminal completion when webhook signing secret is unavailable."
        }
      ]
    },
    {
      "name": "invoke_model",
      "icon": "Azure",
      "description": "Invoke a model deployment via the project openai/v1/responses API",
      "inputs": [
        {
          "name": "projectEndpoint",
          "title": "Foundry project endpoint",
          "type": "string",
          "required": true,
          "description": "Foundry project data-plane URL, e.g. https://<account>.services.ai.azure.com/api/projects/<project>."
        },
        {
          "name": "deploymentName",
          "title": "Deployment name",
          "type": "string",
          "required": true
        },
        {
          "name": "input",
          "title": "Input",
          "type": "string",
          "required": true
        },
        {
          "name": "conversationId",
          "title": "Conversation ID",
          "type": "string",
          "required": false,
          "description": "Optional Foundry conversation ID to continue multi-turn chat history. When omitted, a new conversation is created for the invoke."
        }
      ]
    }
  ]
}
