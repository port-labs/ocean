#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
INTEGRATION="${INTEGRATION:-${1:-}}"

if [[ -z "$INTEGRATION" ]]; then
	if command -v fzf >/dev/null 2>&1; then
		INTEGRATION="$(
			find "$REPO_ROOT/integrations" -mindepth 1 -maxdepth 1 -type d ! -name '_infra' -exec basename {} \; | sort | fzf --prompt='Select integration: '
		)"
	fi
fi

if [[ -z "$INTEGRATION" ]]; then
	echo "Usage: devbox run -e INTEGRATION=<name> integration-setup"
	echo "   or: devbox run integration-setup   (interactive picker)"
	exit 1
fi

INTEGRATION_DIR="$REPO_ROOT/integrations/$INTEGRATION"

if [[ ! -d "$INTEGRATION_DIR" ]]; then
	echo "Integration not found: integrations/$INTEGRATION"
	exit 1
fi

if [[ ! -f "$INTEGRATION_DIR/pyproject.toml" ]]; then
	echo "No pyproject.toml in integrations/$INTEGRATION"
	exit 1
fi

PYTHON="$(command -v python3)"
PYTHON_VERSION="$("$PYTHON" --version)"

if [[ "$PYTHON_VERSION" != Python\ 3.13* ]]; then
	echo "Expected devbox Python 3.13, got: $PYTHON_VERSION ($PYTHON)"
	echo "Run this inside devbox shell: devbox shell"
	exit 1
fi

cd "$INTEGRATION_DIR"

# make install deactivates venvs before poetry install, which lets nix Poetry pick 3.14.
# Create the venv explicitly with devbox Python, then install into it.
if [[ -d .venv ]]; then
	venv_version="$(.venv/bin/python --version 2>&1 || true)"
	if [[ "$venv_version" != Python\ 3.13* ]]; then
		echo "Removing .venv ($venv_version) — recreating with $PYTHON_VERSION"
		rm -rf .venv
	fi
fi

if [[ ! -d .venv ]]; then
	"$PYTHON" -m venv .venv
fi

# shellcheck disable=SC1091
source .venv/bin/activate

poetry install --with dev --no-root
pip install -e ../../

echo ""
echo "Integration '$INTEGRATION' is ready ($("$PYTHON" --version))."
echo "  cd integrations/$INTEGRATION"
echo "  source .venv/bin/activate"
